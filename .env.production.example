# ==============================================================================
# Hostinger Production Environment Configuration
# Copy this file to .env before starting the production deployment:
#   cp .env.production.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Database (PostgreSQL 17)
# ------------------------------------------------------------------------------
# Choose strong, unique credentials. The database port is not exposed externally.
POSTGRES_DB=kahoot
POSTGRES_USER=kahoot_admin
# Generate a strong password (e.g. openssl rand -hex 24)
POSTGRES_PASSWORD=replace_with_strong_production_password_here

# ------------------------------------------------------------------------------
# 2. JWT Authentication (Security)
# ------------------------------------------------------------------------------
# The JWT signing key MUST be at least 32 characters long.
# Generate a secure 256-bit key using: openssl rand -base64 48
JWT_SIGNING_KEY=replace_with_secure_random_key_min_32_chars_long_123456789
JWT_ISSUER=kahoot-api
JWT_AUDIENCE=kahoot-clients
JWT_ACCESS_TOKEN_MINUTES=15
JWT_REFRESH_TOKEN_DAYS=14

# ------------------------------------------------------------------------------
# 3. Initial Host Account Seeding (Optional)
# ------------------------------------------------------------------------------
# If set, automatically creates the default administrator/host account on startup.
HOST_SEED_USERNAME=IEEEXtreme Section
HOST_SEED_PASSWORD=replace_with_strong_host_password_here

# ------------------------------------------------------------------------------
# 4. CORS Allowed Origins
# ------------------------------------------------------------------------------
# Enter your public production domain(s) separated by commas.
# Examples:
#   CORS_ALLOWED_ORIGINS=https://myquizgame.com,https://www.myquizgame.com
CORS_ALLOWED_ORIGINS=https://yourdomain.com

# ------------------------------------------------------------------------------
# 5. Frontend & Reverse Proxy Configuration
# ------------------------------------------------------------------------------
# When deployed together with Nginx, use relative paths so requests stay on the same domain:
VITE_API_URL=/api
VITE_SIGNALR_URL=/hubs/game

# Host port mapped to Nginx (default 80):
HTTP_PORT=80
