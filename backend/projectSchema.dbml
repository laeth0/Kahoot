// =============================================================================
// KAHOOT-LIKE PLATFORM - DATABASE SCHEMA (DBML)
// =============================================================================
// Documentation: https://dbml.dbdiagram.io/docs/
// Visualize at: https://dbdiagram.io/
// VS Code: Install "dbdiagram" / "DBML" extension to preview
// -----------------------------------------------------------------------------
// Source of truth for the physical PostgreSQL schema produced by the
// Kahoot.Domain entities plus the EF Core model configuration. Per
// backend/AGENTS.md this file MUST be updated on every domain/model change,
// in the same task as the matching EF Core migration.
// =============================================================================

Project KahootPlatform {
  database_type: 'PostgreSQL'
  Note: '''
  Real-time quiz platform. PostgreSQL is the single durable source of truth for
  all persistent business data.

  Conventions:
  - Primary keys are UUID v7 (time-ordered), generated by the application for
    index locality under high-volume answer inserts.
  - All timestamps are timestamptz stored in UTC.
  - Physical identifiers are snake_case; EF Core is configured with a snake_case
    naming convention.
  - The server is authoritative: deadlines, correctness, scores, game state and
    "already answered" are decided from these rows and server time only.
  '''
}

// =============================================================================
// ENUMS
// =============================================================================

// Server-authoritative game state machine. Allowed transitions:
//   Created         -> Lobby
//   Lobby           -> QuestionActive | Finished
//   QuestionActive  -> QuestionResults | Finished
//   QuestionResults -> Leaderboard | Finished
//   Leaderboard     -> QuestionActive | Finished
//   Finished        -> (terminal)
// Any other transition is rejected server-side
// (Kahoot.Domain.Games.GameStatusTransitions -> InvalidGameStatusTransitionException).
// Persisted as text via EF Core HasConversion<string>().

Enum game_status {
  Created
  Lobby
  QuestionActive
  QuestionResults
  Leaderboard
  Finished
}

// =============================================================================
// HOST / AUTH
// =============================================================================

Table hosts {
  id uuid [pk]
  email varchar(256) [not null, unique, note: 'Stored trimmed + lower-cased; case-insensitive login identity']
  display_name varchar(100) [not null]
  password_hash varchar(256) [not null, note: 'Argon2/BCrypt hash only; never a plaintext or reversible value']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    email [unique, name: 'uq_host_email']
  }

  Note: 'Owns quizzes and game sessions. Not hard-deleted while any game_session references it (game_sessions.host_id is ON DELETE RESTRICT).'
}

Table refresh_tokens {
  id uuid [pk]
  host_id uuid [not null, ref: > hosts.id, note: 'ON DELETE CASCADE']
  token_hash varchar(128) [not null, unique, note: 'SHA-256 hex of the opaque refresh token; the raw token is returned to the client once and never stored']
  expires_at timestamptz [not null]
  revoked_at timestamptz [null, note: 'Set on rotation or logout. Active when revoked_at IS NULL AND now() < expires_at']
  replaced_by_token_id uuid [null, ref: > refresh_tokens.id, note: 'Rotation chain: the token that superseded this one']
  created_at timestamptz [not null, default: `now()`]

  indexes {
    token_hash [unique, name: 'uq_refresh_token_hash', note: 'Lookup on refresh']
    host_id [name: 'ix_refresh_token_host_id']
  }

  Note: 'Host session persistence for JWT refresh-token rotation. DESIGN DECISION - see notes at end of file.'
}

// =============================================================================
// QUIZ AUTHORING
// =============================================================================

Table quizzes {
  id uuid [pk]
  host_id uuid [not null, ref: > hosts.id, note: 'Owner. ON DELETE CASCADE']
  title varchar(200) [not null]
  description varchar(1000) [null]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    host_id [name: 'ix_quiz_host_id', note: 'list the quizzes owned by a host']
  }

  Note: 'A quiz referenced by any game_session cannot be deleted (game_sessions.quiz_id is ON DELETE RESTRICT), preserving historical results.'
}

Table questions {
  id uuid [pk]
  quiz_id uuid [not null, ref: > quizzes.id, note: 'ON DELETE CASCADE']
  order_index int [not null, note: '0-based position within the quiz']
  text varchar(500) [not null]
  time_limit_seconds int [not null, default: 20, note: 'CHECK between 5 and 300 (Question.MinTimeLimitSeconds / MaxTimeLimitSeconds)']
  points int [not null, default: 1000, note: 'Base points before the speed factor. CHECK >= 0']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    (quiz_id, order_index) [unique, name: 'uq_question_quiz_order']
    quiz_id [name: 'ix_question_quiz_id', note: 'Load an ordered quiz']
  }

  Note: 'Application-enforced invariant: 2..6 choices, exactly one with is_correct = true.'
}

Table choices {
  id uuid [pk]
  question_id uuid [not null, ref: > questions.id, note: 'ON DELETE CASCADE']
  order_index int [not null, note: '0-based position within the question (0..5)']
  text varchar(300) [not null]
  is_correct boolean [not null, default: false]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    (question_id, order_index) [unique, name: 'uq_choice_question_order']
    question_id [name: 'ix_choice_question_id']
  }

  Note: 'is_correct lives here but is never serialized to participant clients before the question is revealed.'
}

// =============================================================================
// LIVE GAME
// =============================================================================

Table game_sessions {
  id uuid [pk]
  quiz_id uuid [not null, ref: > quizzes.id, note: 'ON DELETE RESTRICT']
  host_id uuid [not null, ref: > hosts.id, note: 'Denormalized owner copied from quizzes.host_id at creation so ownership checks need no join. ON DELETE RESTRICT']
  pin varchar(8) [not null, note: '6-digit numeric join code generated server-side']
  status game_status [not null, default: 'Created']
  current_question_id uuid [null, ref: > questions.id, note: 'Active / most-recent question. ON DELETE RESTRICT']
  current_question_index int [null, note: '0-based pointer into the ordered question list']
  current_question_started_at timestamptz [null, note: 'Server timestamp set when the question opens']
  current_question_ends_at timestamptz [null, note: 'Server-authoritative deadline = current_question_started_at + time_limit_seconds']
  started_at timestamptz [null, note: 'Set once, when the first question starts']
  finished_at timestamptz [null]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    pin [unique, name: 'uq_game_session_active_pin', note: 'PARTIAL UNIQUE WHERE status is not Finished, so a PIN becomes reusable once its game ends']
    host_id [name: 'ix_game_session_host_id']
    quiz_id [name: 'ix_game_session_quiz_id']
    status [name: 'ix_game_session_status', note: 'List active games / metrics']
    current_question_id [name: 'ix_game_session_current_question_id']
  }

  Note: '''
  Optimistic concurrency: EF Core uses the PostgreSQL system column xmin as the
  concurrency token (UseXminAsConcurrencyToken) - no explicit column. Concurrent
  state transitions (e.g. host double-click "Next") fail with a concurrency
  exception and are resolved idempotently.

  CHECK ck_game_session_question_window:
    current_question_ends_at IS NULL OR current_question_started_at IS NULL
    OR current_question_ends_at >= current_question_started_at
  '''
}

Table participants {
  id uuid [pk]
  game_session_id uuid [not null, ref: > game_sessions.id, note: 'ON DELETE CASCADE']
  nickname varchar(30) [not null, note: 'Display nickname as entered']
  nickname_normalized varchar(30) [not null, note: 'Trimmed + lower-cased; used for case-insensitive uniqueness']
  session_token_hash varchar(128) [not null, unique, note: 'SHA-256 hex of the participant reconnection token. This is participant identity on reconnect - NOT the SignalR connection id']
  connection_id varchar(128) [null, note: 'Current SignalR connection id; NULL when disconnected. Transient, never identity']
  last_seen_at timestamptz [not null, note: 'Updated on connect / disconnect / heartbeat for the reconnection window']
  total_score int [not null, default: 0, note: 'Running server-calculated score. CHECK >= 0. Denormalized so the leaderboard is not recomputed from answers on every request']
  last_rank int [null, note: 'Leaderboard position from the last time standings were computed (question close)']
  is_removed boolean [not null, default: false, note: 'Soft removal by the host; the row is kept so existing answers stay valid']
  removed_at timestamptz [null]
  created_at timestamptz [not null, default: `now()`, note: 'Join time']
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    session_token_hash [unique, name: 'uq_participant_session_token']
    (game_session_id, nickname_normalized) [unique, name: 'uq_participant_game_nickname', note: 'PARTIAL UNIQUE WHERE is_removed = false']
    game_session_id [name: 'ix_participant_game_session_id', note: 'Lobby / participant list']
    (game_session_id, total_score) [name: 'ix_participant_game_score', note: 'Leaderboard ordering (query sorts total_score DESC)']
    connection_id [name: 'ix_participant_connection_id', note: 'Resolve the participant on a SignalR disconnect']
  }

  Note: 'Connectivity is derived: connected == connection_id IS NOT NULL (no redundant boolean).'
}

Table answers {
  id uuid [pk]
  game_session_id uuid [not null, ref: > game_sessions.id, note: 'ON DELETE CASCADE']
  question_id uuid [not null, ref: > questions.id, note: 'ON DELETE RESTRICT']
  participant_id uuid [not null, ref: > participants.id, note: 'ON DELETE RESTRICT - participants are soft-removed, never hard-deleted']
  selected_choice_id uuid [not null, ref: > choices.id, note: 'ON DELETE RESTRICT. An answer row always records a selected choice']
  is_correct boolean [not null, note: 'Server-evaluated at submission']
  points_awarded int [not null, default: 0, note: 'Server-calculated final points for this answer. CHECK >= 0']
  response_time_ms int [not null, note: 'server submitted_at - current_question_started_at. CHECK >= 0']
  submitted_at timestamptz [not null, note: 'Server receive time; the only timestamp trusted for deadline evaluation']

  indexes {
    (game_session_id, question_id, participant_id) [unique, name: 'uq_answer_participant_question', note: 'FINAL integrity boundary: one accepted answer per (game, question, participant). A duplicate insert raises a unique violation that the application maps to an idempotent "already answered" response']
    (game_session_id, question_id) [name: 'ix_answer_game_question', note: 'Response count and per-choice aggregation when a question closes']
    participant_id [name: 'ix_answer_participant_id', note: 'answer history for one participant, for the results screen']
    selected_choice_id [name: 'ix_answer_selected_choice_id', note: 'FK integrity checks and per-choice statistics']
  }

  Note: '''
  Hot path - one row is written only for an ACCEPTED answer. Acceptance rule
  (inclusive boundary):
      game_sessions.status = 'QuestionActive'
      AND game_sessions.current_question_id = answers.question_id
      AND submitted_at <= game_sessions.current_question_ends_at
  Late or duplicate submissions create neither a row nor a score.
  '''
}

// =============================================================================
// DESIGN DECISIONS / NOTES
// =============================================================================
// 1. refresh_tokens is included to implement "Host register/login" securely
//    (JWT access token + rotating refresh token, hashed at rest). It is the one
//    entity added beyond the spec's list (Host, Quiz, Question, Choice,
//    GameSession, Participant, Answer). Remove it if a different auth strategy
//    is chosen.
// 2. Question/Choice content is referenced directly by answers rather than
//    snapshotted into the game. Historical correctness is preserved instead by
//    (a) answers.is_correct / points_awarded being frozen at submission time and
//    (b) ON DELETE RESTRICT from game_sessions -> quizzes/questions. Editing a
//    quiz that has a running session is blocked in the application layer.
// 3. PIN uniqueness is scoped to non-finished sessions (partial unique index) so
//    the short numeric space can be reused.
// 4. Leaderboard is not persisted as its own table: participants.total_score is
//    maintained incrementally and participants.last_rank caches the standings
//    computed when a question closes.
// 5. CHECK constraints (ck_question_time_limit 5..300, ck_question_points >= 0,
//    ck_participant_total_score >= 0, ck_answer_points_awarded >= 0,
//    ck_answer_response_time_ms >= 0, ck_game_session_question_window) and the
//    two partial unique indexes are created in EF Core model configuration /
//    migration, not expressible in DBML.
// =============================================================================
