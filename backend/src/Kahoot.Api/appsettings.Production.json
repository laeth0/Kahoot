{
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": ""
  },
  "Database": {
    "EnableDetailedErrors": false,
    "EnableSensitiveDataLogging": false,
    "CommandTimeoutSeconds": 30
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "Jwt": {
    "Issuer": "Kahoot",
    "Audience": "Kahoot",
    "SigningKey": "",
    "AccessTokenMinutes": 15
  },
  "RefreshToken": {
    "LifetimeDays": 14,
    "FamilyMaxLifetimeDays": 30
  }
}
