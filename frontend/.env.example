# Frontend environment configuration (Vite). Copy to `.env` for local dev
# and set the equivalent variables in the Vercel project for each environment.
# Do not commit real `.env` files.

# Base URL of the backend REST API, including the `/api` suffix.
VITE_API_URL=http://localhost:5048/api

# Base URL of the SignalR hub host (without a path). The client appends `/hubs/game`.
VITE_SIGNALR_URL=http://localhost:5048
