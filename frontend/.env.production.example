# Frontend Production Environment Variables

# Base URL for API requests.
# If frontend and backend are served on the same domain (e.g. via Nginx reverse proxy):
VITE_API_URL=/api

# Or if backend is hosted on a separate subdomain/domain:
# VITE_API_URL=https://api.yourdomain.com/api

# Base URL or full endpoint for SignalR game hub.
# If frontend and backend are on the same domain:
VITE_SIGNALR_URL=/hubs/game

# Or if backend is on a separate domain:
# VITE_SIGNALR_URL=https://api.yourdomain.com/hubs/game
