# Load-test configuration for Azure Production Deployment (http://20.19.48.78)
TARGET_URL=http://20.19.48.78
BASE_URL=http://20.19.48.78/api
SIGNALR_URL=http://20.19.48.78
HUB_PATH=/hubs/game

# --- Host credentials (seeded on backend startup) ---------------------------
HOST_USERNAME="IEEEXtreme Section"
HOST_PASSWORD="IEEEXtreme@123456789"

# --- Safety gates -----------------------------------------------------------
TARGET_PRODUCTION_ONLY=true
ALLOW_LOAD_TEST=true
ALLOW_PROD_LOAD_TEST=true
SAFE_VU_LIMIT=50

# --- Scale (Reduced to 250 concurrent users target) -------------------------
PLAYERS=250
GAMES=10
PLAYERS_PER_GAME=25
RECONNECT_PLAYERS=50
ANSWER_TIME_LIMIT=60
ENDURANCE_MINUTES=10
ENDURANCE_QUESTIONS=8
ENDURANCE_PLAYERS=250
RAMP_LEVELS=50,150,250

# --- Connection pacing & rate limit compliance ------------------------------
SIGNALR_SKIP_NEGOTIATION=true
SIGNALR_CONNECT_RETRIES=6
API_429_RETRIES=6
JOIN_RAMP=120s
CONNECT_RAMP=120s
SETTLE_SECONDS=30
CONFIRM_FRACTION=0.3

# --- run-all.js cooldown ----------------------------------------------------
SCENARIO_COOLDOWN=30

# --- Reporting --------------------------------------------------------------
RUN_ID=azure250
