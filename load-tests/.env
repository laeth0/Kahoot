# Target: the Railway-simulation Docker Compose stack
# (docker-compose.railway-sim.yml maps the API to localhost:5000).
BASE_URL=http://localhost:5000/api
SIGNALR_URL=http://localhost:5000
HOST_USERNAME=admin
HOST_PASSWORD=admin

ALLOW_LOAD_TEST=true
SAFE_VU_LIMIT=50

PLAYERS=500
GAMES=10
PLAYERS_PER_GAME=50
RECONNECT_PLAYERS=100

# Pace connection/join traffic under the global per-IP rate limiter
# (240 burst + 120 / 30 s ~= 4 req/s). Skip negotiation => 1 HTTP req/connection.
SIGNALR_SKIP_NEGOTIATION=true
SIGNALR_CONNECT_RETRIES=6
JOIN_RAMP=200s
CONNECT_RAMP=240s
SETTLE_SECONDS=45
ANSWER_TIME_LIMIT=60
CONFIRM_FRACTION=0.3

# Idle between scenarios so the bucket refills before the next setup()
SCENARIO_COOLDOWN=45

RUN_ID=railwaysim
