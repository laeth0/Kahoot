# Native `dotnet run` backend (Release) against the docker-compose `db` container.
# For the Railway-sized run instead: bring up `docker compose up -d db backend`
# with the caps and set BASE_URL=http://localhost:5000/api.
BASE_URL=http://localhost:5048/api
SIGNALR_URL=http://localhost:5048
HOST_USERNAME=admin
HOST_PASSWORD=admin

ALLOW_LOAD_TEST=true
SAFE_VU_LIMIT=50

PLAYERS=500
GAMES=10
PLAYERS_PER_GAME=50
RECONNECT_PLAYERS=100

SIGNALR_SKIP_NEGOTIATION=true
SIGNALR_CONNECT_RETRIES=6
JOIN_RAMP=200s
CONNECT_RAMP=240s
SETTLE_SECONDS=45
ANSWER_TIME_LIMIT=60
CONFIRM_FRACTION=0.3
SCENARIO_COOLDOWN=45

RUN_ID=native500
