# Load-test configuration for `run-all.js`. Ready to use as-is against the
# project docker-compose.yml backend (docker compose up -d --build db backend).
# Plain `k6 run` does NOT read this file — pass -e flags there, or `export` these.

# --- Target: the docker-compose.yml backend --------------------------------
BASE_URL=http://localhost:5000/api
SIGNALR_URL=http://localhost:5000
HUB_PATH=/hubs/game

# --- Host credentials (seeded by the backend on startup) -------------------
HOST_USERNAME=admin
HOST_PASSWORD=admin

# --- Safety gate ----------------------------------------------------------
ALLOW_LOAD_TEST=true
ALLOW_PROD_LOAD_TEST=false
SAFE_VU_LIMIT=50

# --- Scale --------------------------------------------------------------
PLAYERS=500
GAMES=10
PLAYERS_PER_GAME=50
RECONNECT_PLAYERS=100
ANSWER_TIME_LIMIT=60
ENDURANCE_MINUTES=10
ENDURANCE_PLAYERS=200

# --- Connection pacing (single load-generator IP shares the API's per-IP
#     rate limiter: 240 burst + 120 / 30 s). Keep the ramps long. -----------
SIGNALR_SKIP_NEGOTIATION=true
SIGNALR_CONNECT_RETRIES=6
API_429_RETRIES=6
JOIN_RAMP=200s
CONNECT_RAMP=240s
SETTLE_SECONDS=45
CONFIRM_FRACTION=0.3

# --- run-all.js: idle between scenarios so the bucket refills -------------
SCENARIO_COOLDOWN=45

RUN_ID=compose500
