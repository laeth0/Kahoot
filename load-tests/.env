# Load-test configuration for `run-all.js` and k6 against ngrok.
# Target: ngrok unified endpoint
BASE_URL=https://sherill-unexplored-cluelessly.ngrok-free.dev/api
SIGNALR_URL=https://sherill-unexplored-cluelessly.ngrok-free.dev
HUB_PATH=/hubs/game

# --- Host credentials (seeded by the backend on startup) -------------------
HOST_USERNAME="IEEEXtreme Section Lead"
HOST_PASSWORD="IEEEXtreme 20.0"

# --- Safety gate ----------------------------------------------------------
ALLOW_LOAD_TEST=true
ALLOW_PROD_LOAD_TEST=true
SAFE_VU_LIMIT=50

# --- Scale --------------------------------------------------------------
PLAYERS=500
GAMES=10
PLAYERS_PER_GAME=50
RECONNECT_PLAYERS=100
ANSWER_TIME_LIMIT=60
ENDURANCE_MINUTES=10
ENDURANCE_PLAYERS=200

# --- Connection pacing (single load-generator IP shares the API's per-IP
#     rate limiter: 240 burst + 120 / 30 s). Keep the ramps long. -----------
SIGNALR_SKIP_NEGOTIATION=true
SIGNALR_CONNECT_RETRIES=6
API_429_RETRIES=6
JOIN_RAMP=200s
CONNECT_RAMP=240s
SETTLE_SECONDS=45
CONFIRM_FRACTION=0.3

# --- run-all.js: idle between scenarios so the bucket refills -------------
SCENARIO_COOLDOWN=45

RUN_ID=ngrok500
