# ---------------------------------------------------------------------------
# Load-test configuration template. Copy to `.env` and adjust, OR pass values
# via environment variables / `k6 run -e KEY=VALUE ...`.
#
# Keep strictly synchronized with `load-tests/.env`.
# ---------------------------------------------------------------------------

# --- Target -----------------------------------------------------------------
# Root target origin. If set, BASE_URL (${TARGET_URL}/api) and SIGNALR_URL
# (${TARGET_URL}) derive from it automatically unless explicitly overridden.
TARGET_URL=http://20.19.48.78
# REST API base, including /api suffix.
BASE_URL=http://20.19.48.78/api
# SignalR hub origin (no path).
SIGNALR_URL=http://20.19.48.78
# Hub path (matches backend Program.cs `MapHub<GameHub>("/hubs/game")`).
HUB_PATH=/hubs/game

# --- Host credentials (username + password; there is NO registration endpoint) --
HOST_USERNAME="IEEEXtreme Section"
HOST_PASSWORD="replace_with_host_password_here"

# --- Safety gates -----------------------------------------------------------
# When true, rejects execution if the target resolves to localhost/127.0.0.1.
TARGET_PRODUCTION_ONLY=true
# Any scenario whose peak VU count exceeds SAFE_VU_LIMIT refuses to start unless ALLOW_LOAD_TEST=true.
ALLOW_LOAD_TEST=false
# Non-local / production targets require explicit opt-in confirmation.
ALLOW_PROD_LOAD_TEST=false
SAFE_VU_LIMIT=50

# --- Scale (250 concurrent users target) -----------------------------------
PLAYERS=250              # players in single-game scenarios
GAMES=10                 # multiple-games scenario: GAMES x PLAYERS_PER_GAME (10 x 25 = 250)
PLAYERS_PER_GAME=25
RECONNECT_PLAYERS=50     # reconnection scenario
ANSWER_TIME_LIMIT=60     # question time limit (s) used by answer/broadcast tests
ENDURANCE_MINUTES=10     # endurance scenario duration
ENDURANCE_QUESTIONS=8
ENDURANCE_PLAYERS=250
RAMP_LEVELS=50,150,250   # ramp load steps

# --- Connection pacing (single-IP rate-limit mitigation) ---------------------
SIGNALR_SKIP_NEGOTIATION=true    # true = 1 HTTP req/connection (WS upgrade only); recommended at scale
SIGNALR_CONNECT_RETRIES=6        # retry a rate-limited/failed connect this many times
API_429_RETRIES=6               # setup()/director REST: retry a 429 this many times
JOIN_RAMP=120s                   # connect+join all players before the question
CONNECT_RAMP=120s                # connections scenario: ramp VUs up to PLAYERS
SETTLE_SECONDS=30                # director slack after the join ramp
CONFIRM_FRACTION=0.3
SCENARIO_COOLDOWN=30            # run-all.js: idle seconds between scenarios so rate limiter refills

# --- Reporting --------------------------------------------------------------
RUN_ID=azure250                 # tag prefix for nicknames / summary files
