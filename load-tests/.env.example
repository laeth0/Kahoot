# ---------------------------------------------------------------------------
# Load-test configuration. Copy to `.env` and adjust, OR pass every value with
# `k6 run -e KEY=VALUE ...`. NEVER put real staging / Railway credentials in a
# committed file.
#
# `.env` is only read by `run-all.js` (the Node orchestrator). Plain `k6 run`
# does NOT read dotenv files — pass `-e` flags or `export` the variables first.
# ---------------------------------------------------------------------------

# --- Target -----------------------------------------------------------------
# REST API base, including the /api suffix. The SignalR origin is derived from
# this (strip /api) unless SIGNALR_URL is set explicitly.
#   docker-compose.yml backend -> http://localhost:5000/api
#   bare `dotnet run`          -> http://localhost:5048/api
BASE_URL=http://localhost:5000/api
# SignalR hub origin (no path). The client appends HUB_PATH.
SIGNALR_URL=http://localhost:5000
# Hub path (matches Program.cs `MapHub<GameHub>("/hubs/game")`).
HUB_PATH=/hubs/game

# --- Host credentials (username + password; there is NO registration endpoint) --
# Local dev seed is admin/admin (backend appsettings `Seeding:Host`). Override
# for staging / Railway. Prefer passing these with -e instead of a file.
HOST_USERNAME=admin
HOST_PASSWORD=admin

# --- Safety gate ----------------------------------------------------------------
# Any scenario whose peak VU count exceeds SAFE_VU_LIMIT refuses to start unless
# ALLOW_LOAD_TEST=true. Against a URL that looks like production you ALSO need
# ALLOW_PROD_LOAD_TEST=true.
ALLOW_LOAD_TEST=false
ALLOW_PROD_LOAD_TEST=false
SAFE_VU_LIMIT=50

# --- Scale knobs (override per run) -------------------------------------------
PLAYERS=500              # players in the single-game scenarios
GAMES=10                 # multiple-games scenario: GAMES x PLAYERS_PER_GAME
PLAYERS_PER_GAME=50
RECONNECT_PLAYERS=100    # reconnection scenario
ANSWER_TIME_LIMIT=120    # question time limit (s) used by answer/broadcast tests (min 5, max 300)
ENDURANCE_MINUTES=10     # endurance scenario duration
ENDURANCE_QUESTIONS=8

# --- Connection pacing (single-IP rate-limit mitigation) ---------------------
# The API applies a global per-IP token bucket (240 burst + 120 / 30 s ~= 4 req/s
# sustained). From one load-generator IP you cannot open 500 connections
# instantly. These spread the negotiate/upgrade traffic to fit that budget.
CONNECT_RAMP=240s        # connections scenario: ramp VUs up to PLAYERS
JOIN_RAMP=200s           # other scenarios: connect+join all players before the question
SETTLE_SECONDS=40        # director slack after the join ramp (readiness poll + drain + verify)
SIGNALR_SKIP_NEGOTIATION=true    # true = 1 HTTP req/connection (WS upgrade only); recommended at scale
SIGNALR_CONNECT_RETRIES=6        # retry a rate-limited/failed connect this many times (long backoff on 429)
API_429_RETRIES=6               # setup()/director REST: retry a 429 this many times (bucket-refill waits)
SCENARIO_COOLDOWN=45            # run-all.js: idle seconds between scenarios so the bucket refills

# --- Reporting --------------------------------------------------------------
RUN_ID=local             # tag prefix for nicknames / summary files
